PORT=8787
DATABASE_URL=postgres://pawcream:change-me@db:5432/pawcream
SESSION_SECRET=replace-with-a-long-random-secret-at-least-24-characters
INVITE_CODE=replace-with-your-invite-code

# Same-origin production website (GitHub Pages preview needs separate CORS/cookie settings).
CORS_ORIGIN=https://pawcream.studio,https://www.pawcream.studio
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Leave as database until the RAM role and SQL migration have been configured.
# Switch to oss for new public photo uploads. Legacy database images remain readable.
PHOTO_STORAGE=database
OSS_BUCKET=
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_ECS_ROLE_NAME=
