PORT=8787
DATABASE_URL=postgres://pawcream:change-me@db:5432/pawcream
SESSION_SECRET=replace-with-a-long-random-secret-at-least-24-characters
# Legacy INVITE_CODE is no longer accepted. Issue one-time PC-XXXX-XXXX codes from /admin.
# Send a 6-digit OTP to the registering email; registration is disabled until SMTP is configured.
# Example: SMTP_HOST=smtp.example.com, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Same-origin production website (GitHub Pages preview needs separate CORS/cookie settings).
CORS_ORIGIN=https://pawcream.studio,https://www.pawcream.studio
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Stay on database until OSS credentials, the region, and SQL schema are confirmed.
# Switch to oss for new public photo uploads. Legacy database images remain readable.
PHOTO_STORAGE=database
OSS_BUCKET=pawcream-photo
OSS_REGION=oss-cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
# Light-weight application server: access_key. ECS VM: ecs_ram_role.
OSS_AUTH_MODE=access_key
# Never put real values in Git; fill only in backend/.env on the server.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# For ECS VMs only (leave blank on Simple Application Server).
OSS_ECS_ROLE_NAME=
